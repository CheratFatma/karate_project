pipeline {
    agent any

    parameters {
        string(
            name: 'TAG',
            defaultValue: '',
            description: 'Tag Karate à exécuter'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Tests Karate') {
            steps {
                script {
                    if (params.TAG?.trim()) {
                        bat "mvn test -Dkarate.options=\"--tags ${params.TAG}\""
                    } else {
                        bat "mvn test"
                    }
                }
            }
        }
    }
}